# Convencion local de desarrollo para FMCPA.
# Copie este archivo a `.env.local` solo si necesita overrides locales.

FMCPA_SQL_SERVICE_NAME=sqlserver
FMCPA_SQL_CONTAINER_NAME=fmcpa-sql
FMCPA_SQL_PORT=14333
FMCPA_SQL_SA_PASSWORD=Fmcpadev123!Aa
FMCPA_DB_NAME=FMCPA_Development
FMCPA_API_PORT=5080
FMCPA_WEB_PORT=4200
FMCPA_STORAGE_ROOT=App_Data
FMCPA_AUTH_BOOTSTRAP_ENABLED=true
FMCPA_AUTH_BOOTSTRAP_USER_NAME=admin
FMCPA_AUTH_BOOTSTRAP_DISPLAY_NAME=Administrador local
# Defina la contraseña local fuera del repo.
FMCPA_AUTH_BOOTSTRAP_PASSWORD=
FMCPA_AUTH_OPERATOR_USER_NAME=operator
FMCPA_AUTH_OPERATOR_DISPLAY_NAME=Operador local
# Opcional: si se define, se aprovisiona un usuario OPERATOR local. Tambien puede crearse despues desde `/admin/users`.
FMCPA_AUTH_OPERATOR_PASSWORD=
FMCPA_AUTH_READONLY_USER_NAME=readonly
FMCPA_AUTH_READONLY_DISPLAY_NAME=Consulta local
# Opcional: si se define, se aprovisiona un usuario READONLY local. Tambien puede crearse despues desde `/admin/users`.
FMCPA_AUTH_READONLY_PASSWORD=
# Opcional: si se deja vacío en Development, el backend genera una llave efímera por arranque.
FMCPA_AUTH_JWT_SIGNING_KEY=
